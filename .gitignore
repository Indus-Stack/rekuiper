# Binaries for programs and plugins
*.exe
*.dll
*.so
*.dylib
**/target/
brag-output/
/bin/*
!/bin/README.md

# Test binary, build with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Project-local glide cache, RE: https://github.com/Masterminds/glide/issues/736
.glide/
data/*
log/*
plugins/sources/*
plugins/sinks/*
plugins/functions/*
tools/failpoint/bin

.git/
.idea/
.DS_Store
_book
node_modules/

_build
_packages
_plugins
jmeter_logs
kuiper_conf_util
corss_build.tar
corss_build_for_rpm.tar

*.swp
*.history
__pycache__/
*.pyc
telemetry_*.jsonl
*.mp4

*/**/*.db

.vscode/
tools/lint/bin/
go.work.sum
pycache
fix_cve.md
ekuiper240b5.csv
tmp

# Management keys (never commit private keys)
etc/mgmt/*
!etc/mgmt/README.md

# Scratch directory
scratch/

# Blog post materials and temporary benchmark assets
docs/BLOG_POST.md
docs/SUBSTACK_POST.md
test/benchmark/generate_chart.py
test/benchmark/*.png
test/benchmark/temp_race_audio.wav
*.wav


# Sink-cache pages written by broker-backed tests (cwd = crate dir)
crates/*/data/

# Local MQTT throughput runs include large sink archives and scratch reports.
test/benchmark/iiot-mqtt/results/
test/benchmark/iiot-mqtt/scripts/*/target/
test/benchmark/iiot-mqtt/scripts/mqttgen/mqttgen
test/benchmark/iiot-mqtt/scripts/mqttprobe/mqttprobe
test/benchmark/iiot-mqtt/scripts/iotrunner/iotrunner
test/benchmark/iiot-mqtt/evidence/iot-gen-*.json
test/benchmark/iiot-mqtt/evidence/iot-warm-*.json
test/benchmark/iiot-mqtt/evidence/mqttprobe-*.log
test/benchmark/iiot-mqtt/evidence/mqttgen-probe-1000.json
test/benchmark/iiot-mqtt/evidence/mqttprobe-1000.json

.vercel
